<Window x:Class="Clip.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip"
        Width="800"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="#1F1E1F"
        AllowsTransparency="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Auto"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1F1E1F"/>
        <SolidColorBrush x:Key="Surface" Color="#242324"/>
        <SolidColorBrush x:Key="Surface2" Color="#2A282A"/>
        <SolidColorBrush x:Key="Surface3" Color="#343134"/>
        <SolidColorBrush x:Key="Line" Color="#3A373A"/>
        <SolidColorBrush x:Key="Line2" Color="#464246"/>
        <SolidColorBrush x:Key="Text" Color="#F2F0F2"/>
        <SolidColorBrush x:Key="Muted" Color="#8F898F"/>
        <SolidColorBrush x:Key="Muted2" Color="#C7C1C7"/>
        <SolidColorBrush x:Key="Muted3" Color="#6B656B"/>
        <SolidColorBrush x:Key="Accent" Color="#FF6363"/>
        <SolidColorBrush x:Key="TextCursor" Color="#FF6363"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2C2A2C"/>
        <SolidColorBrush x:Key="Selected" Color="#363336"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#4E4A4E"/>
        <SolidColorBrush x:Key="TextSelection" Color="#FF6363"/>
        <SolidColorBrush x:Key="Danger" Color="#D56B5D"/>

        <!-- Raycast's bar, pixel-measured 2026-08-17: 6px pill, #717176, soft anti-aliased
             rounded caps. No pixel snapping here on purpose - snapping is what made the first
             attempt render as a hard-edged block. -->
        <Style x:Key="ThinOverlayScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="False" UseLayoutRounding="False">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#717176" CornerRadius="3" SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scrollbar floats over the content's right edge instead of reserving a gutter
             column, so the content keeps the full width whether or not it scrolls. -->
        <ControlTemplate x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <!-- Raycast-style: invisible until the user scrolls, faded back out by
                     OnInfoScrollChanged once scrolling stops. Not hit-testable so the
                     hidden bar never eats clicks in the margin. -->
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Style="{StaticResource ThinOverlayScrollBar}"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Width="6"
                           Margin="0,0,-16,0"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate>

        <!-- Same overlay bar, but kept inside the viewer's own bounds - for hosts that clip
             to their edge (the text preview), where a bar pushed into the outer margin would
             be cut off. -->
        <ControlTemplate x:Key="OverlayScrollViewerInset" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Style="{StaticResource ThinOverlayScrollBar}"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Width="6"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextCursor}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource TextSelection}"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSegmentLeft" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5,0,0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSegmentRight" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="0,5,5,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted2}"/>
        </Style>

        <!-- Footer keycaps are reference labels, not actions. Painting them with the accent made
             four different things compete for "primary" at once, so nothing read as primary. -->
        <Style x:Key="HotkeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted2}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 8 is DWM's own DWMWCP_ROUND radius, and DWM is what actually clips the window. While the
         palette was opaque its background painted to the window edge and this radius never showed,
         so it could be anything; with the glass backdrop the window background is transparent and
         both silhouettes are visible at once — a 14px fill inside an 8px clip reads as two
         mismatched arcs at every corner. There is no API to widen DWM's radius, so the content
         matches it instead, which is also what the Windows 11 flyouts do. -->
    <Border x:Name="Shell"
            CornerRadius="8"
            Background="{DynamicResource Bg}"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Display"
            TextOptions.TextRenderingMode="Grayscale"
            TextOptions.TextHintingMode="Auto"
            ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SearchRowDef" Height="53"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="FooterRowDef" Height="34"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Bg}" Margin="12,10" MouseLeftButtonDown="OnChromeMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchShell"
                        Grid.Column="0"
                        Height="32"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Vector icon from the same RenderChromeIcon pipeline as the chevrons;
                             the previous '⌕' text glyph was the one font-rendered icon left. -->
                        <Image x:Name="SearchGlyphIcon" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search clipboard history..."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource CleanTextBox}"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     TextChanged="OnSearchChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="AllFilterShell" CornerRadius="5" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource SelectedBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AllButton" Content="All" Style="{StaticResource PillSegmentLeft}" Click="OnAllFilterClick" Foreground="{DynamicResource Text}" Background="Transparent" Padding="0" Width="38"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="DateDropButton" Style="{StaticResource PillSegmentRight}" Click="OnDateDropClick" Foreground="{DynamicResource Text}" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="DateDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TextButton" Content="Text" Style="{StaticResource FilterButton}" Click="OnTextFilterClick" Margin="4,0,0,0" Width="44"/>
                    <Border x:Name="MediaFilterShell" CornerRadius="5" Background="Transparent" BorderBrush="{DynamicResource Line2}" BorderThickness="1" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ImageButton" Content="Media" Style="{StaticResource PillSegmentLeft}" Click="OnImageFilterClick" Background="Transparent" Width="52"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="MediaDropButton" Style="{StaticResource PillSegmentRight}" Click="OnMediaDropClick" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="MediaDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="LinksButton" Content="Links" Style="{StaticResource FilterButton}" Click="OnLinksFilterClick" Margin="4,0,0,0" Width="50"/>
                    <Button x:Name="ColorButton" Content="Color" Style="{StaticResource FilterButton}" Click="OnColorFilterClick" Margin="4,0,0,0" Width="52"/>
                    <Border x:Name="FilesFilterShell" CornerRadius="5" Background="Transparent" BorderBrush="{DynamicResource Line2}" BorderThickness="1" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilesButton" Content="File" Style="{StaticResource PillSegmentLeft}" Click="OnFilesFilterClick" Background="Transparent" Width="38"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="FileDropButton" Style="{StaticResource PillSegmentRight}" Click="OnFileDropClick" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="FileDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Line}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumnDef" Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="ListScroll"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ClipToBounds="True"
                                      Padding="0,0,0,8"
                                      ScrollChanged="OnListScrollChanged"
                                      PreviewMouseWheel="OnListWheel">
                            <StackPanel x:Name="ItemsHost" ClipToBounds="True"/>
                        </ScrollViewer>
                        <!-- Shown by UpdateEmptyState when a render leaves no rows: a blank column
                             next to a still-populated preview read as a bug, not as "no results". -->
                        <TextBlock x:Name="EmptyStateText"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="260"
                                   Margin="24"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{DynamicResource Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="InfoRowDef" Height="180"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PreviewArea" Grid.Row="0" Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewHeaderRowDef" Height="28"/>
                            <RowDefinition x:Name="PreviewHeaderSpacerDef" Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="HeaderIcon" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Clipboard" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SubTitleText" Text="Search, preview, and act on copied items" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="OpenButton" Grid.Column="3" Content="Open" Style="{StaticResource MiniButton}" Click="OnOpenClick" MinWidth="74" Margin="16,0,0,0"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0,2,0,0"
                                ClipToBounds="True">
                            <Grid x:Name="PreviewHost">
                                <TextBox x:Name="TextPreview" Style="{StaticResource CleanTextBox}" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" FontSize="13" FontFamily="JetBrains Mono, Cascadia Mono, Consolas">
                                    <!-- Explicit template so the overlay pill is guaranteed - implicit
                                         window styles never reach a TextBox's internal scrollbar, which
                                         is how the stock 17px Windows bar survived every restyle. -->
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Template="{StaticResource OverlayScrollViewerInset}" Background="Transparent"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Image x:Name="ImagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Button x:Name="ExpandImageButton"
                                        Style="{StaticResource IconButton}"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="OnExpandImageClick"
                                        ToolTip="Expand image">
                                    <Image x:Name="ExpandImageIcon" Width="15" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                                <StackPanel x:Name="PlaceholderPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="PlaceholderIcon" Width="128" Height="128" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="PlaceholderText" Foreground="{DynamicResource Muted}" FontSize="13" TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                                </StackPanel>
                                <StackPanel x:Name="ColorPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="ColorPreviewSwatch" Width="118" Height="118" Stroke="{DynamicResource Line2}" StrokeThickness="1"/>
                                    <TextBlock x:Name="ColorPreviewText" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}">
                        <Grid Margin="24,12,24,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="INFORMATION" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="11"/>
                            </Grid>
                            <ScrollViewer x:Name="InfoScroll" Grid.Row="1" Template="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnInfoScrollChanged">
                                <StackPanel x:Name="InfoHost"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Keycap texts are placeholders only: UpdateFooterHotkeyHints rewrites them
                         from the live hotkey settings, so a rebound key never lies down here. -->
                    <StackPanel x:Name="PasteHintPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="PasteHintKey" Text="Enter" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Paste" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="CopyHintPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="CopyHintKey" Text="Ctrl+C" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Copy" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ActionsHintPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="ActionsHintKey" Text="Ctrl+K" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Actions" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PinHintPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="PinHintKey" Text="Ctrl+P" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Pin" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <!-- Ctrl+Q is hardwired in OnWindowKeyDown, not a rebindable hotkey, so its cap is static. -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock Text="Ctrl+Q" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Shortcuts" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The pause toggle lives in the tray menu, in another process; this badge is
                             what keeps a forgotten pause from silently eating every copy. -->
                        <Border x:Name="CapturePausedBadge"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource Line2}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,10,0"
                                Background="{DynamicResource Surface}">
                            <TextBlock Text="Capture paused" Foreground="{DynamicResource Danger}" FontSize="12" FontWeight="Medium"/>
                        </Border>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource IconButton}"
                                Click="OnSettingsClick"
                                ToolTip="Settings"
                                VerticalAlignment="Center">
                            <Image x:Name="SettingsIcon" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="ActionMenuPopup" AllowsTransparency="True" Placement="MousePoint" StaysOpen="False">
                <Border x:Name="ActionMenuBorder"
                        Background="{DynamicResource Surface}"
                        CornerRadius="8"
                        Padding="4"
                        MinWidth="178"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="ActionMenuHost"/>
                </Border>
            </Popup>

            <Popup x:Name="ShareSubmenuPopup" AllowsTransparency="True" Placement="Right" StaysOpen="False">
                <Border Background="{DynamicResource Surface}"
                        CornerRadius="8"
                        Padding="4"
                        MinWidth="178"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="ShareSubmenuHost"/>
                </Border>
            </Popup>

            <Border x:Name="Toast"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource Text}"
                    CornerRadius="8"
                    Padding="14,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,46">
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource Bg}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            </Border>

            <Border x:Name="ExpandedImageOverlay"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="Transparent"
                    ClipToBounds="True"
                    Focusable="True"
                    MouseLeftButtonDown="OnExpandedOverlayMouseLeftButtonDown"
                    MouseLeftButtonUp="OnExpandedOverlayMouseLeftButtonUp"
                    MouseMove="OnExpandedOverlayMouseMove"
                    MouseLeave="OnExpandedOverlayMouseLeave"
                    MouseWheel="OnExpandedOverlayMouseWheel"
                    SizeChanged="OnExpandedOverlaySizeChanged">
                <Grid x:Name="ExpandedImageViewport" Background="Transparent" ClipToBounds="True">
                    <Image x:Name="ExpandedBackdrop"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <BlurEffect Radius="22" KernelType="Gaussian"/>
                        </Image.Effect>
                    </Image>
                    <Rectangle Fill="#CC000000" IsHitTestVisible="False"/>
                    <Canvas Background="Transparent">
                        <Image x:Name="ExpandedImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
