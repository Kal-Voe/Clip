<!-- AllowsTransparency="True" is load-bearing, not a leftover. It is the only way to get a layered
     window, and a layered window is what ACCENT_ENABLE_ACRYLICBLURBEHIND needs to actually blur the
     desktop behind the palette (PaletteBackdrop has the measured proof that the DWM backdrop it
     replaced never sampled the desktop at all). The standing objection to AllowsTransparency is that
     it disables ClearType — that objection does not apply here: this window deliberately sets
     TextOptions.TextRenderingMode="Grayscale" below, so there is no subpixel rendering to lose.
     Do not revert this on the ClearType argument.

     It also cannot be toggled after the window is created, which is why it is unconditionally True
     rather than driven by the Translucent background setting: the window is always layered, and the
     setting only controls whether the accent policy is applied and whether the Shell paints a sheet.
     That keeps the toggle instant instead of "takes effect next launch".

     Background is Transparent for the same reason: on a layered window the Shell border's rounded
     CornerRadius is the real silhouette, and a window background painted behind it would square the
     corners back off. ApplyTheme paints the Shell, not the window. -->
<Window x:Class="Clip.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip"
        Width="800"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Auto"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <!-- ApplyTheme owns these at runtime: it runs from the constructor, straight after
             InitializeComponent and before the window has ever painted, and SetBrush overwrites
             every key below. So these values are never what you see - but they ARE what anyone
             reading this file believes the app looks like, and they used to be a different hue
             family entirely (warm greys with a magenta cast: #1F1E1F, #8F898F) against the
             neutral greys that actually ship. Kept, because the designer surface and any lookup
             before ApplyTheme still need them, but held to the same values ApplyTheme installs.
             Change one, change the other. -->
        <SolidColorBrush x:Key="Bg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Surface" Color="#212121"/>
        <SolidColorBrush x:Key="Surface2" Color="#272727"/>
        <SolidColorBrush x:Key="Surface3" Color="#323232"/>
        <SolidColorBrush x:Key="Line" Color="#494949"/>
        <SolidColorBrush x:Key="Line2" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Muted" Color="#A3A3A3"/>
        <SolidColorBrush x:Key="MutedBright" Color="#BBBBBB"/>
        <SolidColorBrush x:Key="Accent" Color="#FF6363"/>
        <SolidColorBrush x:Key="TextCursor" Color="#FF6363"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="Selected" Color="#373737"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#525252"/>
        <SolidColorBrush x:Key="TextSelection" Color="#FF6363"/>
        <SolidColorBrush x:Key="Danger" Color="#D56B5D"/>

        <!-- Raycast's bar, pixel-measured 2026-08-17: 6px pill, #717176, soft anti-aliased
             rounded caps. No pixel snapping here on purpose - snapping is what made the first
             attempt render as a hard-edged block. -->
        <Style x:Key="ThinOverlayScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="False" UseLayoutRounding="False">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#717176" CornerRadius="3" SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scrollbar floats over the content's right edge instead of reserving a gutter
             column, so the content keeps the full width whether or not it scrolls. -->
        <ControlTemplate x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <!-- Raycast-style: invisible until the user scrolls, faded back out by
                     OnInfoScrollChanged once scrolling stops. Not hit-testable so the
                     hidden bar never eats clicks in the margin. -->
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Style="{StaticResource ThinOverlayScrollBar}"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Width="6"
                           Margin="0,0,-16,0"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate>

        <!-- Same overlay bar, but kept inside the viewer's own bounds - for hosts that clip
             to their edge (the text preview), where a bar pushed into the outer margin would
             be cut off. -->
        <ControlTemplate x:Key="OverlayScrollViewerInset" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Style="{StaticResource ThinOverlayScrollBar}"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Width="6"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextCursor}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource TextSelection}"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover lights the outline, it does not fill. A grey wash on hover was
                                 the last of the filled states and read as heavy, and how heavy
                                 depended on the monitor. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource MutedBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSegmentLeft" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5,0,0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- The shell owns this pill's outline, so a half cannot light one of
                                 its own; brightening the ink is the hover state here. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSegmentRight" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="0,5,5,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- The shell owns this pill's outline, so a half cannot light one of
                                 its own; brightening the ink is the hover state here. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Outline, not a filled block. A resting grey fill made this read as a heavy chip
                 sitting on the preview; the fill now only appears under the pointer. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource MutedBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No box. These three buttons are a glyph and nothing else, so the hover state is the
             glyph's own stroke coming up to full rather than a 28x28 outline lighting around a
             15px mark - at that ratio the border reads as the control and the icon as decoration.

             The brightening is opacity because the glyph bakes its colour in when it is drawn:
             these are rendered at Text and held at 0.75, which lands on MutedBright over the
             shell background, then go to full on hover. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- #01000000, not Transparent: this is a layered window, where a fully
                             transparent pixel is click-through and the hit area would vanish
                             everywhere the glyph itself is not drawn. -->
                        <Border x:Name="Root" Background="#01000000">
                            <ContentPresenter x:Name="Glyph"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0.75"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer keycaps are reference labels, not actions. Painting them with the accent made
             four different things compete for "primary" at once, so nothing read as primary. -->
        <Style x:Key="HotkeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBright}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 8, matching DWMWCP_ROUND, which is what actually clips this window. Layered or not, DWM's
         corner clip applies (measured), and it is the only thing that can round the acrylic — the
         compositor paints the blur across the whole window rect and ignores WPF's per-pixel alpha,
         so a wider radius here would not round anything, it would just hang this Border's stroke
         inside DWM's arc as a second, mismatched one. Keep equal to MainWindow.ShellCornerRadius;
         a test asserts it. -->
    <Border x:Name="Shell"
            CornerRadius="8"
            Background="{DynamicResource Bg}"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Display"
            TextOptions.TextRenderingMode="Grayscale"
            TextOptions.TextHintingMode="Auto"
            ClipToBounds="True"
            SizeChanged="OnShellSizeChanged"
            PreviewMouseLeftButtonDown="OnChromeMouseDown"
            PreviewMouseMove="OnChromeMouseMove"
            PreviewMouseLeftButtonUp="OnChromeMouseUp">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SearchRowDef" Height="53"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="FooterRowDef" Height="34"/>
            </Grid.RowDefinitions>

            <!-- Gives the blank part of the top bar pixels to be grabbed by, nothing more.
                 #01000000 — alpha 1 of 255 — and NOT Transparent. The palette is a layered window
                 for the acrylic, and a layered window is click-through wherever its alpha is zero:
                 the OS never delivers the click at all, so WPF's "Transparent is hit-testable" rule
                 never gets a say. Measured: grabbing blank top bar did nothing, while the one spot
                 that dragged turned out to be the painted search field. One step of alpha is
                 invisible over the blur and is enough to make the pixels belong to the window.

                 The drag is armed on the Shell's tunnel handlers rather than here, so that grabbing
                 a button drags the window too — see OnChromeMouseDown. -->
            <Border Grid.Row="0" Background="#01000000"/>

            <!-- Transparent, never Bg: the Shell below already paints the Bg sheet, so painting it
                 again here stacked a second 65% layer inset by the margin and squared off at the
                 corners — the "dark rectangle behind the controls". Transparent and not null on
                 purpose: a null Background is not hit-testable, and the top bar is draggable.
                 Do not "tidy" this back to a brush. -->
            <Grid Grid.Row="0" Background="Transparent" Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchShell"
                        Grid.Column="0"
                        Height="32"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Vector icon from the same RenderChromeIcon pipeline as the chevrons;
                             the previous '⌕' text glyph was the one font-rendered icon left. -->
                        <Image x:Name="SearchGlyphIcon" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search clipboard history..."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource CleanTextBox}"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     TextChanged="OnSearchChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="AllFilterShell" CornerRadius="5" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource SelectedBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AllButton" Content="All" Style="{StaticResource PillSegmentLeft}" Click="OnAllFilterClick" Foreground="{DynamicResource Text}" Background="Transparent" Padding="0" Width="38"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="DateDropButton" Style="{StaticResource PillSegmentRight}" Click="OnDateDropClick" Foreground="{DynamicResource Text}" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="DateDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TextButton" Content="Text" Style="{StaticResource FilterButton}" Click="OnTextFilterClick" Margin="4,0,0,0" Width="44"/>
                    <Border x:Name="MediaFilterShell" CornerRadius="5" Background="Transparent" BorderBrush="{DynamicResource Line2}" BorderThickness="1" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ImageButton" Content="Media" Style="{StaticResource PillSegmentLeft}" Click="OnImageFilterClick" Background="Transparent" Width="52"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="MediaDropButton" Style="{StaticResource PillSegmentRight}" Click="OnMediaDropClick" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="MediaDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="LinksButton" Content="Links" Style="{StaticResource FilterButton}" Click="OnLinksFilterClick" Margin="4,0,0,0" Width="50"/>
                    <Button x:Name="ColorButton" Content="Color" Style="{StaticResource FilterButton}" Click="OnColorFilterClick" Margin="4,0,0,0" Width="52"/>
                    <Border x:Name="FilesFilterShell" CornerRadius="5" Background="Transparent" BorderBrush="{DynamicResource Line2}" BorderThickness="1" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilesButton" Content="File" Style="{StaticResource PillSegmentLeft}" Click="OnFilesFilterClick" Background="Transparent" Width="38"/>
                            <Border Width="1" Background="{DynamicResource Line2}" Opacity="0.55"/>
                            <Button x:Name="FileDropButton" Style="{StaticResource PillSegmentRight}" Click="OnFileDropClick" Background="Transparent" Padding="0" Width="18">
                                <Image x:Name="FileDropIcon" Width="11" Height="11" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Line}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumnDef" Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="ListScroll"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ClipToBounds="True"
                                      ScrollChanged="OnListScrollChanged"
                                      PreviewMouseWheel="OnListWheel">
                            <!-- One MouseMove for the whole list, not one per row: a fast drag
                                 leaves its starting row immediately, and the moves that decide
                                 the drag are then raised by the rows it passes over. -->
                            <StackPanel x:Name="ItemsHost" ClipToBounds="True" Margin="0,0,0,8"
                                        MouseMove="OnListMouseMove"
                                        MouseLeftButtonUp="OnListMouseUp"/>
                        </ScrollViewer>
                        <!-- The one thing pinning could not do: start an item that was never a
                             copy. It floats at the top right of the list rather than in the footer,
                             where it read as app chrome; here it sits with the list it adds to.
                             Outside the ScrollViewer so it stays put while the list scrolls, and
                             small and muted so it does not compete with the rows. -->
                        <Button x:Name="NewSnippetButton"
                                Style="{StaticResource IconButton}"
                                Click="OnNewSnippetClick"
                                ToolTip="New Snippet"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,10,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <!-- 20 and 12 on purpose: at 150% they are 30 and 18 physical pixels, so
                                 the inset is a whole 6 either side. At 22/13 it fell on a half pixel
                                 and the plus read as visibly off-centre. -->
                            <Image x:Name="NewSnippetIcon" Width="12" Height="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <!-- Shown by UpdateEmptyState when a render leaves no rows: a blank column
                             next to a still-populated preview read as a bug, not as "no results". -->
                        <TextBlock x:Name="EmptyStateText"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="260"
                                   Margin="24"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{DynamicResource Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="InfoRowDef" Height="180"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PreviewArea" Grid.Row="0" Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewHeaderRowDef" Height="28"/>
                            <RowDefinition x:Name="PreviewHeaderSpacerDef" Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- No icon column. The title used to sit behind a 28px icon and a 10px
                             gap, which put it 38px right of INFORMATION directly below it and made
                             the whole right-hand column look misaligned. The row in the list two
                             inches away already shows that icon, and the preview shows the content
                             itself, so the indent was buying a duplicate at the cost of the
                             column's only vertical edge. -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Clipboard" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SubTitleText" Text="Search, preview, and act on copied items" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="OpenButton" Grid.Column="1" Content="Open" Style="{StaticResource MiniButton}" Click="OnOpenClick" MinWidth="74" Margin="16,0,0,0"/>
                        </Grid>

                        <!-- The preview starts the same drag a row does, for whatever item is
                             previewed. Bubbling, not tunnelling: the text preview is a real
                             TextBox and handles its own button-down, so a press in it never
                             reaches here and selecting text stays selecting text. -->
                        <Border Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0,2,0,0"
                                ClipToBounds="True"
                                MouseLeftButtonDown="OnPreviewSurfaceMouseDown"
                                MouseMove="OnPreviewSurfaceMouseMove">
                            <Grid x:Name="PreviewHost">
                                <TextBox x:Name="TextPreview" Style="{StaticResource CleanTextBox}" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" FontSize="13" FontFamily="Cascadia Mono, Consolas">
                                    <!-- Explicit template so the overlay pill is guaranteed - implicit
                                         window styles never reach a TextBox's internal scrollbar, which
                                         is how the stock 17px Windows bar survived every restyle. -->
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Template="{StaticResource OverlayScrollViewerInset}" Background="Transparent"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Image x:Name="ImagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Button x:Name="ExpandImageButton"
                                        Style="{StaticResource IconButton}"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="OnExpandImageClick"
                                        ToolTip="Expand image">
                                    <Image x:Name="ExpandImageIcon" Width="15" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                                <StackPanel x:Name="PlaceholderPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="PlaceholderIcon" Width="128" Height="128" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="PlaceholderText" Foreground="{DynamicResource Muted}" FontSize="13" TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                                </StackPanel>
                                <StackPanel x:Name="ColorPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="ColorPreviewSwatch" Width="118" Height="118" Stroke="{DynamicResource Line2}" StrokeThickness="1"/>
                                    <TextBlock x:Name="ColorPreviewText" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- No Background: the preview column above already carries the Surface tint and
                         restating it here would double it, so the information panel would read as a
                         darker block inside its own column. The 1px top Line is the divider.
                         Transparent rather than null so the panel still hit-tests and the wheel
                         keeps reaching InfoScroll. -->
                    <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid Margin="24,12,24,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="INFORMATION" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="11"/>
                            </Grid>
                            <ScrollViewer x:Name="InfoScroll" Grid.Row="1" Template="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnInfoScrollChanged">
                                <StackPanel x:Name="InfoHost"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Keycap texts are placeholders only: UpdateFooterHotkeyHints rewrites them
                         from the live hotkey settings, so a rebound key never lies down here. -->
                    <StackPanel x:Name="PasteHintPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="PasteHintKey" Text="Enter" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Paste" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PasteStayHintPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="7,2" Background="{DynamicResource Surface}">
                            <TextBlock x:Name="PasteStayHintKey" Text="Shift+Enter" Style="{StaticResource HotkeyText}"/>
                        </Border>
                        <TextBlock Text="Paste &amp; stay" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The pause toggle lives in the tray menu, in another process; this badge is
                             what keeps a forgotten pause from silently eating every copy. -->
                        <Border x:Name="CapturePausedBadge"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource Line2}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,10,0"
                                Background="{DynamicResource Surface}">
                            <TextBlock Text="Capture paused" Foreground="{DynamicResource Danger}" FontSize="12" FontWeight="Medium"/>
                        </Border>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource IconButton}"
                                Click="OnSettingsClick"
                                ToolTip="Settings"
                                VerticalAlignment="Center">
                            <Image x:Name="SettingsIcon" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="ActionMenuPopup" AllowsTransparency="True" Placement="MousePoint" StaysOpen="False">
                <!-- The margin is what keeps the last row on screen. A Popup sizes its window to the
                     child's desired size and takes no account of an Effect, so the shadow's offset
                     and blur pushed the bottom of the menu outside the window and it was clipped:
                     the Delete row vanished entirely and the row above it lost its lower border.
                     Reserving the shadow's own spread here fixes it without moving the menu, since
                     the growth is all bottom-right and placement anchors top-left. -->
                <Border x:Name="ActionMenuBorder"
                        Background="{DynamicResource Surface}"
                        CornerRadius="8"
                        Margin="0,0,34,34"
                        Padding="4"
                        MinWidth="178"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="ActionMenuHost"/>
                </Border>
            </Popup>

            <Popup x:Name="ShareSubmenuPopup" AllowsTransparency="True" Placement="Right" StaysOpen="False">
                <!-- Surface here is only the starting color; ApplyTheme re-paints both menu borders
                     opaque, because a Popup is its own window with no acrylic under it. -->
                <!-- The margin is what keeps the last row on screen. A Popup sizes its window to the
                     child's desired size and takes no account of an Effect, so the shadow's offset
                     and blur pushed the bottom of the menu outside the window and it was clipped:
                     the Delete row vanished entirely and the row above it lost its lower border.
                     Reserving the shadow's own spread here fixes it without moving the menu, since
                     the growth is all bottom-right and placement anchors top-left. -->
                <Border x:Name="ShareSubmenuBorder"
                        Background="{DynamicResource Surface}"
                        CornerRadius="8"
                        Margin="0,0,34,34"
                        Padding="4"
                        MinWidth="178"
                        BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="ShareSubmenuHost"/>
                </Border>
            </Popup>

            <Border x:Name="Toast"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource Text}"
                    CornerRadius="8"
                    Padding="14,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,46">
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource Bg}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            </Border>

            <Border x:Name="ExpandedImageOverlay"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="Transparent"
                    ClipToBounds="True"
                    Focusable="True"
                    MouseLeftButtonDown="OnExpandedOverlayMouseLeftButtonDown"
                    MouseLeftButtonUp="OnExpandedOverlayMouseLeftButtonUp"
                    MouseMove="OnExpandedOverlayMouseMove"
                    MouseLeave="OnExpandedOverlayMouseLeave"
                    MouseWheel="OnExpandedOverlayMouseWheel"
                    SizeChanged="OnExpandedOverlaySizeChanged">
                <Grid x:Name="ExpandedImageViewport" Background="Transparent" ClipToBounds="True">
                    <Image x:Name="ExpandedBackdrop"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <BlurEffect Radius="22" KernelType="Gaussian"/>
                        </Image.Effect>
                    </Image>
                    <Rectangle Fill="#CC000000" IsHitTestVisible="False"/>
                    <Canvas Background="Transparent">
                        <Image x:Name="ExpandedImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
