<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clip.Core\Clip.Core.csproj" />
    <ProjectReference Include="..\Clip.Watcher\Clip.Watcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Clip.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Release builds get their version from the CI tag. This default has to stay ahead of the
         newest published release, otherwise a locally-built install reports itself as outdated
         and the updater offers to replace it with an older public build. -->
    <Version>1.1.12</Version>
    <AssemblyName>Clip</AssemblyName>
    <AssemblyTitle>Clip</AssemblyTitle>
    <Product>Clip</Product>
    <Description>Local Windows clipboard history app.</Description>
    <ApplicationIcon>..\..\assets\app-icons\clip-tile-light.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010: the WinForms analyzer wants DPI set through Application.SetHighDpiMode, but
         this is a WPF app (WinForms is only along for Screen/FolderBrowserDialog) and WPF reads
         Per-Monitor V2 from the manifest — the supported mechanism here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\app-icons\*.*" Link="assets\app-icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Shell is what reads these (AssetIconPath / RenderFileSvg). Only Clip.Watcher copied
         them, so it worked purely because both projects land in the same output folder - build
         or publish the Shell alone and every file-type icon silently fell back to the generic
         vector document glyph. -->
    <Content Include="..\..\assets\icons\*.svg" Link="assets\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
